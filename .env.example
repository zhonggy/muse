# ---------- 控制台 ----------
# 留空 MUSE_CONSOLE_PASSWORD 则控制台不鉴权（仅建议内网 / 反代已加认证时使用）
MUSE_CONSOLE_USER=admin
MUSE_CONSOLE_PASSWORD=change-me-please

# 卡片加密密钥。强烈建议显式设置；不设置则用 data/secret.key（容器重建会丢）
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MUSE_SECRET_KEY=

# ---------- 服务端口 ----------
HOST_PORT=8080

# ---------- skymail 收码（也可登录后在控制台「设置」里改）----------
SKYMAIL_BASE_URL=https://skymail.ink
SKYMAIL_EMAIL=
SKYMAIL_PASSWORD=

# ---------- 默认参数（均可在控制台覆盖）----------
MUSE_HEADLESS=true
MUSE_CONCURRENCY=1
MUSE_CODE_TIMEOUT=240
MUSE_SCREENSHOT_INTERVAL=1.5
MUSE_STOP_AT_VERIFICATION=false
# 生日不再手填，在 [MIN, MAX] 年内随机
MUSE_BIRTHDAY_YEAR_MIN=1995
MUSE_BIRTHDAY_YEAR_MAX=2002
# 自动建邮箱用的域名；留空则取 skymail 已有邮箱的域名
MUSE_EMAIL_DOMAIN=
# 是否推送实时画面（也可在控制台切换）
MUSE_LIVE_VIEW=true
# MUSE_PROXY=http://user:pass@host:port
